#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 0.001
    upAxis = "Z"
)

def Xform "Asset"
{
    def ParticleField3DGaussianSplat "Splat"
    {
        float[] opacities = [0]
        quatf[] orientations = [(0.5, 0.5, -0.5, 0.5)]
